<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:LmsMobile.Converters">

    <Color x:Key="Danger">#C62828</Color>
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="Warning">#EF6C00</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#2A2A2A</Color>
    <Color x:Key="PageLight">#F4F2FB</Color>
    <Color x:Key="PageDark">#141414</Color>

    <conv:StatusToColorConverter x:Key="StatusColor" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <Style x:Key="Tag" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PageBackground" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
    </Style>

</ResourceDictionary>
