<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LmsMobile.Views.Manager.TeamPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LmsMobile.ViewModels.Manager"
    xmlns:m="clr-namespace:LmsMobile.Models"
    x:DataType="vm:TeamViewModel"
    Style="{StaticResource PageBackground}"
    Title="Team">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="18,12,18,0">
        <SearchBar Placeholder="Search name, code or department" Text="{Binding SearchText}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Employees}">
                <CollectionView.EmptyView>
                    <Label Text="No employees found." Style="{StaticResource MutedText}"
                           HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Employee">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeamViewModel}}, Path=OpenCommand, x:DataType=vm:TeamViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                                <Label Grid.Column="1" Grid.RowSpan="2" Text="Inactive" Style="{StaticResource Tag}"
                                       BackgroundColor="Gray" IsVisible="{Binding IsInactive}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
